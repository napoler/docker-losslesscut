# EditorConfig helps maintain consistent coding styles
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{Dockerfile,GNUmakefile,.dockerignore}]
indent_size = tab

[*.yaml]
indent_size = 2

[*.yml]
indent_size = 2
